  FPAS{
    LIN_protocol = "2.1" ;
    configured_NAD = 0x58 ;
    initial_NAD = 0x58 ;
    product_id = 0x0, 0x0, 255 ;
    response_error = FPAS_RESP_ERROR ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      BCM_FPAS_INFO ;
      FPAS_SENSOR_INFO ;
      CDE_RESEAU_LIN ;
    }
  }
}

